{
  "name": "lunar-site-planner",
  "private": true,
  "version": "0.1.0",
  "description": "Compare lunar landing sites and dates: Sun and Earth over the real horizon, solar power and direct-to-Earth link windows. CesiumJS + LOLA terrain.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/fix-cesium-path.mjs",
    "preview": "vite preview",
    "test": "node --test test/*.spec.js",
    "test:e2e": "node test/browser-e2e.cjs http://localhost:5174/"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "cesium": "1.138.0"
  },
  "devDependencies": {
    "vite": "^6.4.1",
    "vite-plugin-cesium": "^1.2.23"
  },
  "overrides": {
    "@cesium/widgets": "14.3.0",
    "@cesium/engine": "22.3.0"
  }
}
